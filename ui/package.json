{
  "name": "dsh-exp-ui",
  "version": "0.9.5",
  "private": true,
  "description": "exp-ui：经验库的界面外壳（内置示例数据）。接口与返回值已按文档固定，真实经验库接入前先用它验证界面与交互。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./shell": "./shell.js",
    "./data-source": "./data-source.js",
    "./mock": "./mock.js",
    "./live": "./live.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "shell.js",
    "data-source.js",
    "mock.js",
    "live.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "API.md"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node tests/mock.test.mjs && node tests/shell.test.mjs && node tests/client.test.mjs && node tests/contract.test.mjs && node tests/render.test.mjs && node tests/live.test.mjs && node tests/pages-smoke.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 || >=0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "experience",
    "ui",
    "panel"
  ],
  "license": "MIT",
  "author": "yhPrime"
}

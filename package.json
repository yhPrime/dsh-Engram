{
  "name": "dsh-engram",
  "version": "0.19.45",
  "description": "Engram（记忆痕迹）：经验与技能引擎 + 经验库控制台，一个标准 DSH 插件。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./plugin.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./engine": "./kernel/engine.js",
    "./core": "./kernel/core.js",
    "./store": "./kernel/store.js",
    "./tools": "./kernel/tools.js",
    "./retrieval": "./kernel/retrieval.js",
    "./skills": "./kernel/skills.js",
    "./settings": "./kernel/settings.js",
    "./shell": "./ui/shell.js",
    "./live": "./ui/live.js",
    "./mock": "./ui/mock.js",
    "./data-source": "./ui/data-source.js",
    "./locale/*.json": "./ui/locale/*.json",
    "./ooxml": "./kernel/ooxml.js",
    "./artifact-diff": "./kernel/artifact-diff.js"
  },
  "files": [
    "index.js",
    "plugin.js",
    "cordis.patch.yml",
    "icon.svg",
    "kernel/*.js",
    "kernel/LICENSE",
    "kernel/THIRD-PARTY-NOTICES.md",
    "client.js",
    "ui/shell.js",
    "ui/live.js",
    "ui/mock.js",
    "ui/data-source.js",
    "ui/locale/*.json",
    "ui/API.md",
    "README.md",
    "RELEASES.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "ui/icons-gallery.js"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 || >=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "*",
    "dsh-mnemon-source-memory-spaces": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "dsh-mnemon-source-memory-spaces": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "experience",
    "skills",
    "console",
    "memory"
  ],
  "license": "MIT",
  "author": "yhPrime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhPrime/dsh-Engram.git"
  },
  "homepage": "https://github.com/yhPrime/dsh-Engram#readme",
  "bugs": {
    "url": "https://github.com/yhPrime/dsh-Engram/issues"
  }
}
